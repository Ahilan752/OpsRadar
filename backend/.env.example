# OpsRadar Backend Environment Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/opsradar

# JWT Configuration
JWT_SECRET=opsradar-change-me-to-a-very-long-random-string-at-least-64-characters
JWT_REFRESH_SECRET=opsradar-change-me-to-a-refresh-secret-at-least-64-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS Backend Account Details (The identity that assumes the customer role)
AWS_REGION=us-east-1
AWS_BACKEND_ACCOUNT_ID=111122223333
AWS_BACKEND_ROLE_ARN=arn:aws:iam::111122223333:role/OpsRadarBackendExecutionRole
AWS_STS_SESSION_DURATION=900

# Metadata Encryption Key (64 hex characters = 32 bytes for AES-256-GCM)
METADATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Security & Rate Limiting
RATE_LIMIT_MAX=200

