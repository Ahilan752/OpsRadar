[Unit]
Description=OpsRadar Backend API Daemon
After=network.target mongod.service

[Service]
Type=simple
User=opsradar
WorkingDirectory=/opt/opsradar/backend
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opsradar-api

Environment=NODE_ENV=production
EnvironmentFile=/opt/opsradar/backend/.env

# Hardening measures
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
